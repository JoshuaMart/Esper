{
  "name": "esper",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web && biome check .",
    "format": "biome check --write .",
    "test": "node --test \"packages/*/test/**/*.test.ts\"",
    "esper": "node packages/cli/src/main.ts",
    "docs": "pnpm --filter @esper/docs dev",
    "fetch-targets": "node scripts/fetch-targets.ts",
    "reference": "node scripts/reference.ts",
    "measure-claims": "node scripts/measure-claims.ts",
    "web": "pnpm --filter @esper/web build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  }
}
